# Copy to .env and adjust.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SITE_URL=http://127.0.0.1:8000

# Database: sqlite | mysql | postgresql
DB_ENGINE=mysql
DB_NAME=portfolio
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Role given automatically to newly registered users
DEFAULT_USER_ROLE=client

# Email (console backend prints emails in the terminal during development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# ---- Cloud / Vercel ------------------------------------------------------
# On Vercel set these in: Project -> Settings -> Environment Variables
#   SECRET_KEY        a long random string (required)
#   DATABASE_URL      Neon connection string, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/portfolio?sslmode=require
#   CLOUDINARY_URL    from Cloudinary -> Settings -> API Keys, e.g. cloudinary://123:abc@cloud-name
#   SITE_URL          https://your-project.vercel.app  (or your own domain)
#   ALLOWED_HOSTS     your own domain if you add one, e.g. ektiarsoft.com,www.ektiarsoft.com
#   CSRF_TRUSTED_ORIGINS  https://ektiarsoft.com,https://www.ektiarsoft.com  (own domain only)
#
# Only on your computer, to copy this site to the cloud once:
#   python manage.py clone_to_cloud
# CLOUD_DATABASE_URL=postgresql://...neon.tech/portfolio?sslmode=require
# CLOUDINARY_URL=cloudinary://...

# ---- Image to Text: AI mode (Claude) -------------------------------------
# Get a key at https://console.anthropic.com (prepaid credits). Set it in Vercel, never in git.
# ANTHROPIC_API_KEY=
# OCR_AI_MODEL=claude-opus-5-5        # e.g. claude-haiku-5-5 for a much cheaper option
# OCR_AI_DAILY_LIMIT=30               # AI extractions per logged-in user per day
